.state-view {
  padding: 64rpx 30rpx; text-align: center;
  border: 1rpx dashed var(--line); border-radius: 28rpx;
  background: var(--surface-soft);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
}
.state-mark {
  display: grid; width: 76rpx; height: 76rpx; margin: 0 auto 20rpx; place-items: center;
  border: 1rpx solid var(--line); border-radius: 50%;
  background: var(--jade-soft); color: var(--jade); font-size: 30rpx;
}
.state-error .state-mark { color: var(--red); background: var(--red-soft); }
.state-title { color: var(--ink); font-family: "Songti SC","STSong",serif; font-size: 29rpx; font-weight: 700; letter-spacing: 1rpx; }
.state-detail { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.65; overflow-wrap: anywhere; opacity: .9; }
.state-action {
  display: inline-flex; margin-top: 22rpx; padding: 14rpx 28rpx;
  border: 1rpx solid var(--jade); border-radius: 999rpx;
  background: var(--jade-soft); color: var(--jade); font-size: 22rpx; font-weight: 700;
}