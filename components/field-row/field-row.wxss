.field-row { display: flex; min-height: 102rpx; align-items: center; gap: 18rpx; padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.field-row:last-child { border-bottom: 0; }
.field-key { flex: none; width: 160rpx; color: var(--muted); font-size: 24rpx; }
.field-content { flex: 1; min-width: 0; color: #aaa296; font-size: 27rpx; line-height: 1.4; overflow-wrap: anywhere; text-align: right; }
.field-content.has-value { color: var(--ink); }
.field-content.disabled { color: var(--muted); }
.field-arrow { flex: none; color: var(--muted); font-size: 38rpx; line-height: 1; }
