.metric { min-width: 0; padding: 24rpx 22rpx; border: 1rpx solid var(--line); border-top: 3rpx solid var(--jade); border-radius: 16rpx; background: var(--surface); }
.metric-gold { border-top-color: var(--gold); }
.metric-blue { border-top-color: var(--blue); }
.metric-red { border-top-color: var(--red); }
.metric-label { color: var(--muted); font-size: 22rpx; }
.metric-value { margin-top: 12rpx; overflow: hidden; color: var(--ink); font-family: "Songti SC", "STSong", serif; font-size: 42rpx; font-weight: 700; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
.metric-hint { margin-top: 9rpx; color: var(--muted); font-size: 20rpx; line-height: 1.4; }
