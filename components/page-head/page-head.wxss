.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.copy { min-width: 0; }
.eyebrow { color: var(--jade); font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; opacity: .86; }
.title { margin-top: 10rpx; font-family: "Songti SC","STSong",serif; font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 1.15; }
.subtitle { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; opacity: .9; }
.head-action {
  flex: none; margin-top: 8rpx; padding: 14rpx 24rpx;
  border: 1rpx solid var(--line); border-radius: 999rpx;
  background: var(--surface-strong); color: var(--jade); font-size: 22rpx; font-weight: 700;
  box-shadow: 0 3rpx 12rpx rgba(60,40,39,.06);
}