page {
  --paper: #f4f0e8;
  --surface: rgba(255,255,255,.74);
  --surface-strong: rgba(255,255,255,.92);
  --surface-soft: rgba(253,245,242,.82);
  --ink: #2a2022;
  --muted: #8a6460;
  --line: rgba(216,156,146,.34);
  --jade: #5a3835;
  --jade-soft: rgba(244,166,184,.24);
  --gold: #b58555;
  --gold-soft: rgba(181,133,85,.16);
  --red: #9a4d55;
  --red-soft: rgba(154,77,85,.15);
  --blue: #446b85;
  --shadow: 0 12rpx 28rpx rgba(140,90,82,.10);
  --glow: radial-gradient(circle,rgba(244,166,184,.42) 0%,rgba(255,214,170,.14) 65%,transparent 100%);
  --btn-grad: linear-gradient(135deg,#3c2827 0%,#6b423e 50%,#3c2827 100%);
  --btn-text: #fdf7f2;
  --page-bg: linear-gradient(180deg,#fdf5f2 0%,#f8e8e4 52%,#f1dad4 100%);
  --nav-bg: #fdf5f2;
  --nav-front: #2a2022;
  min-height: 100%;
  background: var(--page-bg);
  color: var(--ink);
  font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  font-size: 28rpx;
}
view,text,input,textarea,button,image,scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; line-height: inherit; }
button::after { display: none; }
input,textarea { color: var(--ink); }
.serif { font-family: "Songti SC","STSong","Noto Serif SC",Georgia,serif; }
.money { font-family: "Songti SC","STSong",Georgia,serif; font-variant-numeric: tabular-nums; font-weight: 700; }
.app-page { min-height: 100vh; padding: 24rpx 28rpx 160rpx; background: var(--page-bg); color: var(--ink); }
.app-page.no-tab { padding-bottom: 44rpx; }
.top-bar { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; }
.top-meta { display: inline-flex; align-items: center; min-height: 52rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--muted); font-size: 20rpx; }
.eyebrow-row { display: flex; align-items: center; gap: 8rpx; }
.eyebrow { color: var(--jade); font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; opacity: .86; }
.seal-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--jade); }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.page-title { margin-top: 6rpx; font-family: "Songti SC","STSong",serif; font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 1.2; }
.page-sub { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.head-action { min-height: 58rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface-strong); color: var(--jade); font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.hero-banner { position: relative; margin-bottom: 22rpx; padding: 28rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 34rpx; background: var(--surface-strong); box-shadow: var(--shadow); }
.hero-orb { position: absolute; right: -50rpx; top: -50rpx; width: 240rpx; height: 240rpx; border-radius: 50%; background: var(--glow); pointer-events: none; }
.glass-card { position: relative; margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); box-shadow: var(--shadow); }
.glass-card.flat { margin: 0; }
.soft-panel { padding: 20rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface-soft); }
.grid-2 { display: flex; flex-wrap: wrap; gap: 14rpx; }
.grid-2 > .glass-card,.grid-2 > .engine-card,.grid-2 > .soft-panel { width: calc(50% - 7rpx); margin: 0; }
.grid-3 { display: flex; flex-wrap: wrap; gap: 12rpx; }
.grid-3 > view { width: calc(33.333% - 8rpx); }
.grid-4 { display: flex; flex-wrap: wrap; gap: 12rpx; }
.grid-4 > .bento-cell { width: calc(25% - 9rpx); }
.row { display: flex; align-items: center; gap: 14rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.grow { flex: 1; min-width: 0; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 26rpx 0 14rpx; }
.section-title { font-family: "Songti SC","STSong",serif; font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.section-note { color: var(--muted); font-size: 20rpx; }
.seal-bar { display: inline-block; width: 8rpx; height: 26rpx; flex: none; border-radius: 99rpx; background: var(--jade); }
.tag { display: inline-flex; min-height: 38rpx; align-items: center; padding: 0 13rpx; border-radius: 999rpx; background: var(--jade-soft); color: var(--jade); font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.tag-gold { background: var(--gold-soft); color: var(--gold); }
.tag-red { background: var(--red-soft); color: var(--red); }
.tag-plain { background: transparent; color: var(--muted); }
.progress-track { width: 100%; height: 13rpx; overflow: hidden; border-radius: 999rpx; background: var(--line); }
.progress-fill { height: 100%; border-radius: 999rpx; background: var(--jade); transition: width .35s ease; }
.engine-card { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface-strong); box-shadow: var(--shadow); color: var(--ink); text-align: left; }
.engine-card.primary { border-color: transparent; background: var(--btn-grad); color: var(--btn-text); }
.engine-card.primary .muted,.engine-card.primary .engine-desc { color: inherit; opacity: .82; }
.engine-code { font-size: 17rpx; letter-spacing: 1rpx; opacity: .8; }
.engine-title { margin-top: 12rpx; font-family: "Songti SC","STSong",serif; font-size: 31rpx; font-weight: 700; }
.engine-desc { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; line-height: 1.45; }
.bento-cell { padding: 18rpx 8rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: var(--surface); box-shadow: var(--shadow); text-align: center; }
.bento-ico { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; margin: 0 auto 10rpx; border-radius: 18rpx; background: var(--jade-soft); color: var(--jade); font-size: 28rpx; }
.bento-ico.gold { background: var(--gold-soft); color: var(--gold); }
.bento-label { font-size: 21rpx; font-weight: 700; }
.seg-tabs { display: flex; margin-bottom: 20rpx; padding: 5rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); }
.seg-tab { flex: 1; min-height: 62rpx; padding: 0 8rpx; border-radius: 999rpx; color: var(--muted); font-size: 21rpx; font-weight: 600; }
.seg-tab.active { background: var(--jade); color: var(--btn-text); font-weight: 700; }
.btn-mini { display: inline-flex; min-height: 52rpx; align-items: center; justify-content: center; gap: 5rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface-strong); color: var(--jade); font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.btn-mini.primary { border-color: transparent; background: var(--btn-grad); color: var(--btn-text); }
.btn-mini.danger { border-color: rgba(154,77,85,.3); background: var(--red-soft); color: var(--red); }
.btn { display: flex; min-height: 84rpx; align-items: center; justify-content: center; padding: 0 28rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; }
.btn-primary { background: var(--btn-grad); color: var(--btn-text); }
.btn-secondary { border: 1rpx solid var(--line); background: var(--surface-strong); color: var(--jade); }
.btn-danger { background: var(--red-soft); color: var(--red); }
.btn[disabled] { opacity: .48; }
.input-mini { width: 100%; height: 70rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface-strong); color: var(--ink); font-size: 24rpx; }
.textarea-mini { width: 100%; min-height: 160rpx; padding: 18rpx 22rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface-strong); color: var(--ink); font-size: 24rpx; line-height: 1.55; }
.input-bare { width: 100%; min-height: 50rpx; border: 0; background: transparent; color: var(--ink); font-size: 24rpx; }
.field-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 76rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: var(--surface-soft); }
.field-label { color: var(--muted); font-size: 21rpx; }
.field-value { color: var(--ink); font-size: 24rpx; font-weight: 700; text-align: right; }
.placeholder { color: var(--muted); opacity: .7; }
.muted { color: var(--muted); }
.small { font-size: 20rpx; }
.divider { height: 1rpx; background: var(--line); }
.dashed-top { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx dashed var(--line); }
.avatar { display: flex; width: 78rpx; height: 78rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: var(--jade-soft); color: var(--jade); font-family: "Songti SC","STSong",serif; font-size: 30rpx; font-weight: 700; }
.avatar.solid { background: var(--btn-grad); color: var(--btn-text); }
.state { padding: 48rpx 24rpx; border: 1rpx dashed var(--line); border-radius: 24rpx; color: var(--muted); text-align: center; line-height: 1.65; }
.state-title { color: var(--ink); font-size: 27rpx; font-weight: 700; }
.state-action { display: inline-flex; margin-top: 16rpx; padding: 12rpx 22rpx; border: 1rpx solid var(--jade); border-radius: 999rpx; color: var(--jade); font-size: 21rpx; }
.sticky-bar { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(122rpx + env(safe-area-inset-bottom)); z-index: 35; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface-strong); box-shadow: 0 14rpx 36rpx rgba(40,28,26,.18); }
.sticky-bar.no-tab { bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.drawer-mask { position: fixed; inset: 0; z-index: 80; display: flex; flex-direction: column; justify-content: flex-end; background: rgba(10,8,8,.52); }
.drawer-panel { max-height: 76vh; padding: 28rpx; overflow-y: auto; border-top: 1rpx solid var(--line); border-radius: 36rpx 36rpx 0 0; background: var(--paper); color: var(--ink); }
.drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.drawer-title { font-family: "Songti SC","STSong",serif; font-size: 30rpx; font-weight: 700; }
.drawer-item { margin-bottom: 14rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: var(--surface); }
.drawer-list { display: flex; flex-direction: column; gap: 12rpx; }
.mini-metric { padding: 20rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: var(--surface); }
.mini-metric-label { color: var(--muted); font-size: 20rpx; }
.mini-metric-value { margin-top: 8rpx; font-family: "Songti SC","STSong",serif; font-size: 36rpx; font-weight: 700; }
.empty-inline { padding: 34rpx 16rpx; color: var(--muted); font-size: 22rpx; text-align: center; }
