<app-nav title="客户跟进" back="{{true}}"></app-nav>
<view class="app-page" style="{{theme.style}}">
  <view class="top-bar"><theme-switch bind:change="onTheme"></theme-switch><text class="top-meta" bindtap="load">同步记录 ↻</text></view>
  <view class="page-head"><view><view class="eyebrow-row"><text class="seal-dot"></text><text class="eyebrow">CLIENT CARE</text></view><view class="page-title">客户跟进</view><view class="page-sub">佩戴体验回访、换线养护提醒与生辰礼遇时间轴，可一键转入今日待办。</view></view></view>
  <view wx:if="{{memberId}}" class="glass-card" style="border-color:var(--jade);background:var(--jade-soft);"><view class="row-between"><view><view style="font-size:26rpx;font-weight:700;">已带入客户：{{memberName}}</view><view class="muted small" style="margin-top:4rpx;">为这位客户补一条跟进记录。</view></view><text class="tag tag-gold">已绑定</text></view></view>
  <view class="row" style="margin-bottom:18rpx;"><input class="input-mini grow" value="{{keyword}}" placeholder="客户或跟进内容" placeholder-class="placeholder" bindinput="onKeyword" bindconfirm="load" /><button class="btn-mini" bindtap="load">搜索</button></view>
  <view wx:if="{{memberId}}" class="glass-card">
    <view class="section-title" style="margin-bottom:12rpx;">✦ 新增跟进</view>
    <textarea class="textarea-mini" value="{{content}}" placeholder="本次沟通内容，如：已确认换弹力线尺寸" placeholder-class="placeholder" bindinput="onContent" />
    <view class="row" style="margin-top:12rpx;"><input class="input-mini grow" value="{{nextTime}}" placeholder="下次跟进日期，如 2026-11-02" placeholder-class="placeholder" bindinput="onNextTime" /><button class="btn-mini primary" loading="{{saving}}" bindtap="saveFollow">保存</button></view>
  </view>
  <view wx:if="{{loading && !rows.length}}" class="state"><view class="state-title">正在读取跟进</view></view>
  <view wx:elif="{{error && !rows.length}}" class="state" bindtap="load"><view class="state-title">跟进加载失败</view><view>{{error}}</view><text class="state-action">重试</text></view>
  <view wx:elif="{{!rows.length}}" class="state"><view class="state-title">还没有跟进记录</view><view>从客户档案点“跟进记录”可直接带客户过来。</view></view>
  <view wx:for="{{rows}}" wx:key="id" class="timeline-row">
    <view class="timeline-dot"></view>
    <view class="glass-card grow" style="margin-bottom:16rpx;">
      <view class="row-between"><view class="row"><text style="font-size:27rpx;font-weight:700;">{{item.memberName || '未记名'}}</text><text class="tag">{{item.followTypeName || '跟进'}}</text></view><text class="muted small">{{item.timeText}}</text></view>
      <view class="follow-content">{{item.content || '未填写内容'}}</view>
      <view class="row-between" style="margin-top:12rpx;"><text class="small" style="color:var(--gold);font-weight:600;">下次：{{item.nextText}}</text><button class="btn-mini" data-index="{{index}}" bindtap="toTask">+ 转今日待办</button></view>
    </view>
  </view>
  <view wx:if="{{error && rows.length}}" class="glass-card small" style="color:var(--red);">{{error}}</view>
</view>
<bottom-nav active=""></bottom-nav>
