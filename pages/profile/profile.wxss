.profile-avatar {
  display: flex; width: 106rpx; height: 106rpx; flex: none; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--btn-grad); color: var(--btn-text);
  font-family: "Songti SC","STSong",serif; font-size: 42rpx; font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(60,40,39,.24), inset 0 2rpx 0 rgba(255,255,255,.28);
}
.season-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.season-card {
  width: calc(50% - 7rpx); padding: 24rpx;
  border: 1rpx solid var(--line); border-radius: 28rpx;
  background: var(--surface); color: var(--ink); text-align: left;
  box-shadow: var(--shadow), inset 0 2rpx 0 rgba(255,255,255,.6);
  backdrop-filter: blur(22rpx); -webkit-backdrop-filter: blur(22rpx);
  transition: border-color .2s ease, box-shadow .2s ease, transform .15s ease;
}
.season-card:active { transform: scale(.98); }
.season-card.active { border-color: var(--jade); box-shadow: 0 14rpx 32rpx rgba(120,72,62,.18), inset 0 0 0 2rpx var(--jade); }
.season-dot { display: inline-block; width: 22rpx; height: 22rpx; margin-right: 6rpx; border: 2rpx solid rgba(255,255,255,.85); border-radius: 50%; box-shadow: 0 2rpx 6rpx rgba(60,40,39,.16); }
.profile-logout { width: 100%; touch-action: manipulation; }
.profile-logout.is-loading { opacity: .56; }
.logout-modal-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(34,20,20,.48); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); }
.logout-modal { width: 100%; padding: 34rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--surface-strong); box-shadow: 0 24rpx 70rpx rgba(40,28,26,.28); }
.logout-modal-title { font-family: "Songti SC","STSong",serif; color: var(--ink); font-size: 34rpx; font-weight: 700; }
.logout-modal-content { margin-top: 18rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.logout-modal-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.logout-modal-btn { display: flex; min-height: 76rpx; flex: 1; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }
.logout-modal-btn.secondary { border: 1rpx solid var(--line); color: var(--jade); background: var(--surface); }
.logout-modal-btn.primary { color: var(--btn-text); background: var(--btn-grad); }
