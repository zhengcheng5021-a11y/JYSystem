.profile-avatar { display: flex; width: 104rpx; height: 104rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: var(--btn-grad); color: var(--btn-text); font-size: 42rpx; font-weight: 700; }
.season-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.season-card { width: calc(50% - 7rpx); padding: 22rpx; border: 1rpx solid var(--line); border-radius: 26rpx; background: var(--surface); color: var(--ink); text-align: left; }
.season-card.active { border-color: var(--jade); box-shadow: inset 0 0 0 1rpx var(--jade); }
.season-dot { display: inline-block; width: 20rpx; height: 20rpx; margin-right: 4rpx; border: 2rpx solid; border-radius: 50%; }
