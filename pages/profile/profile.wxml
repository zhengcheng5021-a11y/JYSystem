<app-nav title="我的"></app-nav>
<view class="app-page" style="{{theme.style}}">
  <view class="top-bar"><theme-switch bind:change="onTheme"></theme-switch><text class="top-meta">JINGYUE ATELIER</text></view>
  <view class="hero-banner profile-hero">
    <view class="hero-orb"></view>
    <view class="row">
      <view class="serif profile-avatar">{{initial}}</view>
      <view class="grow">
        <view class="row" style="flex-wrap:wrap;"><text class="serif" style="font-size:34rpx;font-weight:700;">{{nickName}}</text><text class="tag tag-gold">官方认证顾问</text></view>
        <view class="muted small" style="margin-top:8rpx;">账号：{{userName || '未登录'}} · 租户节点 #{{tenantId}}</view>
        <view class="muted small" style="margin-top:4rpx;">权限级别：{{permissionText}}</view>
      </view>
    </view>
  </view>
  <view class="section-head"><view class="row"><text class="seal-bar"></text><text class="section-title">四时画境 · 主题长廊</text></view><text class="section-note">与登录页光影一脉相承</text></view>
  <view class="season-grid">
    <button wx:for="{{seasons}}" wx:key="id" class="season-card {{theme.id===item.id?'active':''}}" data-id="{{item.id}}" bindtap="chooseSeason">
      <view class="row-between"><view class="row"><text class="season-dot" style="background:{{item.navBg}};border-color:{{item.navFront}};"></text><text class="serif" style="font-size:25rpx;font-weight:700;">{{item.short}}</text></view><text wx:if="{{theme.id===item.id}}" class="tag">当前</text></view>
      <view class="muted small" style="margin-top:9rpx;">{{item.label}}</view>
    </button>
  </view>
  <view class="glass-card" bindtap="copyBase">
    <view class="row-between" style="padding-bottom:16rpx;border-bottom:1rpx solid var(--line);"><view class="grow"><view style="font-size:25rpx;font-weight:700;">API 服务端地址</view><view class="muted small" style="margin-top:5rpx;word-break:break-all;">{{apiBase}}</view></view><text class="tag">点击复制</text></view>
    <view class="muted small" style="margin-top:14rpx;line-height:1.6;">复杂字典配置、批量导入导出与财务长报表继续留在电脑端静悦工作台，小程序端专注柜面高频移动作业。</view>
  </view>
  <button class="btn btn-danger" style="margin-top:24rpx;" bindtap="logout">退出登录</button>
</view>
<bottom-nav active="profile"></bottom-nav>
